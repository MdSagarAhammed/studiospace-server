# Copy to .env and fill in.

# Server
PORT=5010
# Comma-separated list of allowed frontend origins (CORS + BetterAuth trusted origins)
CLIENT_URL=http://localhost:3000

# MongoDB (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# BetterAuth
# Must match the Better Auth mount path. Production uses the frontend proxy host.
BETTER_AUTH_URL=http://localhost:5010/api/backend/auth
BETTER_AUTH_SECRET=generate_a_long_random_secret_here

# Google OAuth credentials (console.cloud.google.com → OAuth consent + credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
