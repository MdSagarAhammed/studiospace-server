{
  "name": "studiospace-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express + MongoDB REST API and BetterAuth server for StudioSpace",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env src/server.js",
    "start": "node src/server.js",
    "seed": "node src/config/seed.js",
    "test": "node scripts/e2e.mjs",
    "test:unit": "node --test scripts/*.test.mjs",
    "check": "node --check src/server.js && node --check src/app.js"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
